p.kudos {
  background-image: none !important;
  background-color: rgba(15, 15, 15, 0.7);
  position: relative;
  border-radius: 10px;
  padding-left: 80px;
  min-height: 80px;
  color: #D5C3D7;
}

p.kudos::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 8px;
  transform: translateY(-50%);
  width: 65px;
  height: 65px;
  background: url("https://i.postimg.cc/pLLsmxfW/Kudos.png") no-repeat center center;
  background-size: contain;
}

