h1,
h2,
h3,
h4,
h5,
h6,
.heading {
  font-family: "Century Gothic", "Merriweather", "Times New Roman", sans-serif;
  border-bottom: none;
  font-weight: normal;
  color: #D5C3D7;
}

#outer {
  background: #0F0F0F;
  background-image: url("https://i.postimg.cc/QddfFsQN/BG.png");
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: fixed;
  background-position: center;
}

#header h1.heading a::before {
  content: " 𖣠 ᴀʀᴄʜɪᴠᴇ ᴏꜰ ᴏᴜʀ ᴏᴡɴ 𖣠 ";
  color: transparent !important;
  font-size: 1.2em;
  text-shadow: 0 0 0 #D5C3D7;
}

#header .heading {
  height: 4em;
  color: #D5C3D7;
}

#header .logo,
#header .heading sup,
#header h1.heading span {
  display: none;
}

#greeting img.icon {
  height: 22px;
  width: 22px;
  border-radius: 25px;
  border: 1px solid #0F0F0F;
}

#main {
  color: #D5C3D7;
}

#main a {
  color: #D5C3D7;
}

#main a:hover {
  color: #D4DBE8;
}

#header ul.primary {
  box-shadow: none;
  padding-top: 55px;
  padding-bottom: 55px;
  color: #C0C0C0;
  background: #ABABAB url("https://i.postimg.cc/T3NCmS0G/Header.png");
  background-attachment: fixed;
  background-size: 100%;
  background-repeat: repeat;
  border-radius: 15px;
  border: 1px solid #0F0F0F;
}

#greeting .menu {
  width: 12em !important;
}

#header .menu {
  width: 20em;
  background: #0F0F0F;
  border: 1px solid #0F0F0F;
  font-family: "Century Gothic", "Merriweather", "Times New Roman", sans-serif;
  border-bottom: none;
  font-weight: normal;
  color: #D5C3D7;
}

#header .dropdown .menu a:hover,
#header .dropdown .menu a:focus {
  background: #0F0F0F;
  color: #D4DBE8;
}

#header a.dropdown-toggle,
#greeting .user > li:nth-of-type(3) a {
  background: rgba(15, 15, 15, 0.7);
  border-radius: 25px;
  color: #D5C3D7 !important;
  font-family: "Century Gothic", "Merriweather", "Times New Roman", sans-serif;
  border-bottom: none;
  font-weight: normal;
}

#header .menu li a {
  background: #0F0F0F;
  color: #D5C3D7 !important;
}

#header .menu li {
  border-bottom: none;
}

#header .dropdown:hover a,
#greeting .user > li:nth-of-type(3) a:hover {
  background: #0F0F0F;
  border-radius: 0px;
  color: #D4DBE8 !important;
}

#footer {
  background: url("https://i.postimg.cc/t4v2Pfk9/Footer.png");
  background-size: cover;
  background-position-x: center;
  background-position-y: center;
  background-repeat: no-repeat;
  border-top: 1px solid #7A7A79;
  box-shadow: none;
}

#footer .heading {
  font-variant: small-caps;
  color: #D5C3D7;
}

#footer li,
#footer li a,
#footer button {
  text-decoration: none;
  color: #D5C3D7;
}

.favorite.module.odd h3.heading,
.latest.news.module h3.heading span.title,
.random.readings.module h3.heading span.title,
.latest.messages.module h3.heading span.title,
.social.module h3.heading {
  color: #D5C3D7;
  font-variant: small-caps;
}

.latest.news.module h3.heading,
.latest.messages.module.odd h3.heading {
  border-bottom: none;
  background: rgba(15, 15, 15, 0.7);
  border-radius: 10px;
}

div.favorite.module {
  padding: 10px;
  box-sizing: border-box;
  border-radius: 10px;
  background: rgba(15, 15, 15, 0.7);
  box-shadow: none;
}

.splash .favorite li:nth-of-type(2n+1) a,
.splash .favorite li:nth-of-type(2n+2) a {
  background: rgba(15, 15, 15, 0.5);
  border-radius: 10px;
  color: #D5C3D7;
}

.splash .favorite li:nth-of-type(2n+1) a::before,
.splash .favorite li:nth-of-type(2n+2) a::before {
  content: " 🕶️ ";
  color: transparent !important;
  text-shadow: 0 0 0 #D5C3D7;
}

.splash .favorite li:nth-of-type(2n+1) a:hover,
.splash .favorite li:nth-of-type(2n+2) a:hover {
  background: #0F0F0F;
  color: #D4DBE8 !important;
}

.splash .favorite li:nth-of-type(2n+1) a:hover::before,
.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " 🦻 ";
  color: transparent !important;
  text-shadow: 0 0 0 #D4DBE8;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-45%);
  width: 80px;
  height: 120px;
  background-image: url("https://i.postimg.cc/J7jHfYGY/Fav-Tags.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: "ꜰᴜɴɴy... ɪ ɴᴇᴠᴇʀ ᴍɪꜱꜱ ᴀɴyᴛʜɪɴɢ.";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(20px);
  border-radius: 10px;
  background: rgba(15, 15, 15, 0.7);
  text-align: center;
  font-size: 14px;
  color: #D5C3D7;
  opacity: 1;
  white-space: pre;
}

.news.index.group li.post.group {
  background: rgba(15, 15, 15, 0.7);
  border-radius: 10px;
  border: 10px solid transparent;
  padding: 0.4em;
  margin-bottom: 2em;
  color: #D5C3D7;
}

.splash .news blockquote p:first-child {
  padding-left: 90px;
  background: url("https://i.postimg.cc/YCCdvk6k/News-Icon.png");
  background-size: 80px 80px;
  background-position-x: left;
  background-position-y: top;
  background-repeat: no-repeat;
}

div.social.module {
  padding: 10px;
  box-sizing: border-box;
  border-radius: 10px;
  background: rgba(15, 15, 15, 0.7);
  box-shadow: none;
}

.social.module p {
  padding-left: 90px;
  background: url("https://i.postimg.cc/fRqBXFCV/Follow-Us.png");
  background-size: 80px 80px;
  background-position-x: left;
  background-position-y: top;
  background-repeat: no-repeat;
}

.notice,
.comment_notice,
.kudos_notice,
ul.notes,
.caution,
.error,
.comment_error,
.kudos_error,
.alert.flash,
.LV_invalid {
