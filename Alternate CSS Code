}

form.verbose legend,
.verbose form legend {
  background: #0F0F0F;
  border: 2px solid #0F0F0F;
  border-radius: 8px;
  color: #D5C3D7;
}

span.question {
  background: #1B191C;
  border: 1px solid #1B191C;
  padding: 1px;
  color: #D5C3D7;
  font-family: "Century Gothic", "Times New Roman", sans-serif;
}

input[type="checkbox"],
.actions li label input[type="checkbox"] {
  appearance: none;
  background: #1B191C;
  border: 1px solid #1B191C;
  width: 15px;
  height: 15px;
  border-radius: 4px;
}

input[type="checkbox"]:checked,
.actions li label input[type="checkbox"]:checked {
  background: #D5C3D7;
}

input[type=radio] {
  appearance: none;
  background: #1B191C;
  border: 1px solid #1B191C;
  width: 12px;
  height: 12px;
  border-radius: 50%;
}

input[type=radio]:checked {
  background: #D5C3D7;
}

.filters .indicator:before {
  background: #1B191C;
  border: 1px solid #1B191C;
  background-image: none;
}

.filters [type="checkbox"]:checked + .indicator:before {
  background: #D5C3D7;
  background-image: none;
  color: #D5C3D7;
}

.filters [type="radio"]:checked + .indicator:before {
  background: #D5C3D7;
  background-image: none;
}

.filters .exclude [type="checkbox"]:checked + .indicator:before {
  background: #D5C3D7;
  background-image: none;
  color: #D5C3D7;
}

.filters .more dd.search,
dd.autocomplete li.input {
  max-width: 10.7em;
}

.resp-sharing-button--bluesky,
.resp-sharing-button--tumblr {
